# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3003

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins in production
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=30000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=pulse:

# ─── Auth — REQUIRED ──────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Optional — only needed for Anthropic SSE/WS paths.
# Default provider is Ollama (local, no key required).
# ANTHROPIC_API_KEY=sk-ant-...

# ─── BYOK Encryption — REQUIRED IN PRODUCTION ─────────────────────────────────
# AES-256-GCM master key for encrypting user API keys at rest.
# Generate: openssl rand -base64 32
# Optional in dev (insecure all-zero fallback used with a console warning).
# ENCRYPTION_KEY=

# ─── WebSocket ────────────────────────────────────────────────────────────────
WS_MAX_PAYLOAD_BYTES=65536
WS_HEARTBEAT_INTERVAL_MS=30000
WS_RECONNECT_BACKOFF_MAX_MS=30000
WS_REPLAY_TTL_SECONDS=300
