{
  "name": "@pulse/api",
  "version": "0.0.0",
  "private": true,
  "description": "Pulse AI backend — Fastify, raw WebSockets, PostgreSQL, Redis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.0.0",
    "@pulse/logger": "workspace:*",
    "@pulse/telemetry": "workspace:*",
    "@pulse/types": "workspace:*",
    "@pulse/utils": "workspace:*",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@pulse/eslint-config": "workspace:*",
    "@pulse/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3",
    "vitest": "^2.0.0"
  }
